{
    "name": "1eonardo-dev/monitoring-client",
    "description": "PHP client for reporting events (crash/exception/log) to Monitoring Platform.",
    "type": "library",
    "license": "MIT",
    "keywords": ["monitoring", "observability", "crash-reporting", "logging"],
    "authors": [
        {
            "name": "Leonardo D. Palma",
            "homepage": "https://github.com/1eonardo-dev"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0 || ^12.0"
    },
    "suggest": {
        "laravel/framework": "To use the Laravel ServiceProvider/Facade (LeonardoDev\\Monitoring\\Laravel)",
        "yiisoft/yii2": "To use the Yii2 component (LeonardoDev\\Monitoring\\Yii2)"
    },
    "autoload": {
        "psr-4": {
            "LeonardoDev\\Monitoring\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LeonardoDev\\Monitoring\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LeonardoDev\\Monitoring\\Laravel\\MonitoringServiceProvider"
            ],
            "aliases": {
                "Monitoring": "LeonardoDev\\Monitoring\\Laravel\\Monitoring"
            }
        }
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
